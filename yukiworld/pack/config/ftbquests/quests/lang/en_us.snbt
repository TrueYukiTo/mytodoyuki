	"quest.6EFDC129A5E655C8.title": "Очищенный обсидиан"
	"quest.700ACC5353176D54.title": "Элитная схема"
	"quest.706DE86F278B1CB1.quest_desc": [
		"&b«Зима — это не смерть, а сон природы. Пока меня нет, сады увядают. Вырасти их заново — и природа вернёт мне свою силу.»"
	]
	"quest.706DE86F278B1CB1.title": "Письмо Юки: жизнь"
	"quest.70B1940EDDBA0D57.quest_desc": [
		"4 гранулы для Сердца."
	]
	"quest.70B1940EDDBA0D57.title": "Антиматерия"
	"quest.70DF7976EDB97CD2.quest_desc": [
		"Из него выпадают 1–2 &dОсколка звезды&r."
	]
	"quest.70DF7976EDB97CD2.title": "Иссушитель"
	"quest.70E347B80E252513.title": "Заряжающие стержни"
	"quest.722A08E8FB00CE36.quest_desc": [
		"Защити себя — путь будет долгим."
	]
	"quest.722A08E8FB00CE36.title": "Железная броня"
	"quest.7255B6F809A55E24.quest_desc": [
		"&b«Моя сила — это магия. Машины умеют её хранить, но не умеют чувствовать. Научись слушать Источник — и ты сможешь создать мою Эссенцию.»"
	]
	"quest.7255B6F809A55E24.title": "Письмо Юки: магия"
	"quest.72A2F8B39E8EF57F.title": "Морозный нагрудник"
	"quest.734C4CB35F8F1EF0.quest_desc": [
		"Высокое напряжение."
	]
	"quest.734C4CB35F8F1EF0.title": "Конденсатор HV"
	"quest.738780E3FFD63833.title": "Звёздный свет"
	"quest.739DFD3E1E115858.title": "Драконья кожа"
	"quest.754676B0785CD949.title": "Поставщик шаблонов"
	"quest.75780AE2F5FBEDBF.quest_desc": [
		"Цифровая сеть хранения."
	]
	"quest.75780AE2F5FBEDBF.title": "ME-контроллер"
	"quest.7586ECA3E68AF649.title": "Блоки кристаллов"
	"quest.7609EDD99B4BFC3D.title": "Амброзий"
	"quest.7684305439AF2525.title": "Плита"
	"quest.76AC66B0296A2734.quest_desc": [
		"&b«Ты справился, Хранитель. Но чтобы дойти до Энда, тебе понадобятся машины, магия и знания всех миров. Начни с шестерёнок — у Create есть то, что однажды соберёт моё Сердце.»"
	]
	"quest.76AC66B0296A2734.title": "Первая запись Летописи"
	"quest.770593FD2E294B2D.title": "Медовые лакомства"
	"quest.79B7919BBDF76867.quest_desc": [
		"Сожми материю до сингулярности."
	]
	"quest.79B7919BBDF76867.title": "Конденсатор материи"
	"quest.7ADC0C715B406F23.quest_desc": [
		"Всё великое начинается с простого верстака."
	]
	"quest.7ADC0C715B406F23.title": "Верстак"
	"quest.7AE372A93522CC3D.quest_desc": [
		"Нужно для Ядра измерений и Apotheosis."
	]
	"quest.7AE372A93522CC3D.title": "Дыхание дракона"
	"quest.7B1C8EF9782C3473.quest_desc": [
		"Сердце раннего Mekanism."
	]
	"quest.7B1C8EF9782C3473.title": "Металлургический инфузор"
	"quest.7B333CA06817DB65.quest_desc": [
		"Механический пресс Create."
	]
	"quest.7B333CA06817DB65.title": "Морозные пластины"
	"quest.7C41033B0D1D721F.quest_desc": [
		"&b«Все четыре Ядра со мной. Осталось соединить их в Сердце — на крафтере девять на девять. Добавь антиматерию Mekanism и кристаллы времени, чтобы оно снова забилось.»"
	]
	"quest.7C41033B0D1D721F.title": "Письмо Юки: сердце"
	"quest.7CA32FCEA9980343.quest_desc": [
		"&b«Вот мы и здесь, Хранитель. За порталом — дракон, который разбил моё Сердце. А за ним, на дальних островах, лежат мои осколки.»&r"
		""
		"&eРуды YukiCore встречаются ТОЛЬКО на внешних островах Энда!"
	]
	"quest.7CA32FCEA9980343.title": "Письмо Юки: Энд"
	"quest.7D4C10F2CED1100C.title": "Кровяной инфузор"
	"quest.7E568C4491C92D08.title": "Плодородная почва"
	"quest.7E8D09236BF1E471.quest_desc": [
