	"quest.6EB34EEA5BF6A04B.title": "Панцири шалкеров"
	"quest.6ECAEFBE44358310.title": "Продвинутая схема"
	"quest.6EE69BCB5F806924.quest_desc": [
		"Они понадобятся, чтобы призвать Иссушителя."
	]
	"quest.6EE69BCB5F806924.title": "Черепа скелетов-иссушителей"
