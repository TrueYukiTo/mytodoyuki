	]
	"quest.6EFDC129A5E655C8.title": "Очищенный обсидиан"
	"quest.6F739AED61475125.quest_desc": [
		"&b«Юкия — мой дом. Здесь всегда идёт снег. Мой первый осколок охраняет Ледяной Колосс — голем, которого Тень заставила забыть, кому он служил.»"
	]
	"quest.6F739AED61475125.title": "Письмо Юки: Юкия"
