	"quest.7DCA59B3146F792B.title": "Небесный нефрит"
	"quest.7DFBC134DFA080DE.title": "Скафандр: брюки"
	"quest.7E42022B337DFD7E.quest_desc": [
		"&b«Сфера показала мне будущее: ты летишь к звёздам. К моим звёздам.»"
	]
